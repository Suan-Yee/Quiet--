APP_ENV=development
APP_PORT=8080
MIGRATIONS_URL=file://migrations
CORS_ALLOWED_ORIGINS=http://localhost:5173
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

DB_HOST=postgres
DB_PORT=5432
DB_USER=quiet_user
DB_PASSWORD=quiet_password
DB_NAME=quiet
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Replace both values before starting. They must be different and at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
JWT_ISSUER=quiet-api
JWT_AUDIENCE=quiet-web

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@quiet.local
PGADMIN_DEFAULT_PASSWORD=admin_password

INITIAL_ADMIN_USERNAME=quietadmin
INITIAL_ADMIN_EMAIL=admin@quiet.local
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
